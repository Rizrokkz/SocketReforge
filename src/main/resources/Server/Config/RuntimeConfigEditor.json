{
  "version": 1,
  "schema": "socketreforge.runtime-config-editor",
  "cardLayouts": {
    "setting_cards": "Scalar, toggle, text, and choice cards",
    "probability_matrix": "Compact per-level outcome probability table",
    "numeric_table": "Compact setting and value table for related numeric controls",
    "mapping_cards": "Editable mapping entry cards",
    "rule_cards": "Editable rule entry cards",
    "loot_rule_cards": "Editable loot rule cards",
    "support_rule_cards": "Editable support material rule cards",
    "ability_cards": "Editable lore ability mapping cards"
  },
  "categories": [
    {
      "id": "socket",
      "groups": [
        { "id": "limits", "layout": "setting_cards" },
        { "id": "punch_success", "layout": "setting_cards" },
        { "id": "punch_break", "layout": "setting_cards" },
        { "id": "special_rules", "layout": "setting_cards" },
