            {
              "Type": "Target",
              "Range": 6.5
            },
            {
              "Type": "Timer",
              "Name": "RuneAdept_EvasiveCooldown",
              "State": "Stopped"
            }
          ]
        },
        "ActionsBlocking": true,
        "Actions": [
          {
            "Type": "SetFlag",
            "Name": "RuneAdept_EvasiveDodge",
            "SetTo": true
          },
          {
            "Type": "TimerStart",
            "Name": "RuneAdept_EvasiveCooldown",
            "StartValueRange": [ 5.0, 5.0 ],
            "RestartValueRange": [ 5.0, 5.0 ]
          }
        ]
      },
      {
