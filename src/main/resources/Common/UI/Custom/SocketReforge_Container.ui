@TitleHeight = 38;

@TitleStyle = LabelStyle(
  FontSize: 15,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  ShrinkTextToFit: true,
  MinShrinkTextToFitFontSize: 11,
  LetterSpacing: 0
);

@Title = Label {
  @Alignment = Center;
  @Text = "";

  Style: (...@TitleStyle, HorizontalAlignment: @Alignment);
  Padding: (Horizontal: 19);
  Text: @Text;
};

@DecoratedContainer = Group {
  @ContentPadding = Padding(Full: 9 + 8);
  @CloseButton = false;

  Group #Title {
    Anchor: (Height: @TitleHeight, Top: 0);
    Background: (TexturePath: "SocketReforgeUI/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
    Padding: (Top: 7);

    Group #ContainerDecorationTop {
      Anchor: (Width: 236, Height: 11, Top: -12);
      Background: "SocketReforgeUI/ContainerDecorationTop.png";
    }
  }

  Group #Content {
    LayoutMode: Top;
    Anchor: (Top: @TitleHeight);
    Padding: @ContentPadding;
    Background: (TexturePath: "SocketReforgeUI/ContainerPatch.png", Border: 23);
  }

  Group #ContainerDecorationBottom {
    Anchor: (Width: 236, Height: 11, Bottom: -6);
    Background: "SocketReforgeUI/ContainerDecorationBottom.png";
  }

  Button #CloseButton {
    Anchor: (Width: 32, Height: 32, Top: -8, Right: -8);
    Style: (
      Default: (Background: "SocketReforgeUI/ContainerCloseButton.png"),
      Hovered: (Background: "SocketReforgeUI/ContainerCloseButtonHovered.png"),
      Pressed: (Background: "SocketReforgeUI/ContainerCloseButtonPressed.png")
    );
    Visible: @CloseButton;
  }
};
