Group #DamagePopupHudRoot {
  Anchor: (Top: 300, Left: 640, Width: 760, Height: 190);
  LayoutMode: Left;

  Group #DamageTakenPanel {
    LayoutMode: Center;
    Anchor: (Width: 210, Height: 42);
    Padding: (Horizontal: 8, Top: 6, Bottom: 6);

    Label #DamageTakenFlat { Anchor: (Width: 120, Height: 34); Style: (FontSize: 22, TextColor: #ffdddd, RenderBold: true, Alignment: Center, VerticalAlignment: Center); Text: ""; Visible: false; }
    Label #DamageTakenCritical { Anchor: (Width: 120, Height: 34); Style: (FontSize: 24, TextColor: #ff5555, RenderBold: true, Alignment: Center, VerticalAlignment: Center); Text: ""; Visible: false; }
    Label #DamageTakenFire { Anchor: (Width: 120, Height: 34); Style: (FontSize: 22, TextColor: #ffaa00, RenderBold: true, Alignment: Center, VerticalAlignment: Center); Text: ""; Visible: false; }
    Label #DamageTakenIce { Anchor: (Width: 120, Height: 34); Style: (FontSize: 22, TextColor: #55ffff, RenderBold: true, Alignment: Center, VerticalAlignment: Center); Text: ""; Visible: false; }
    Label #DamageTakenLightning { Anchor: (Width: 120, Height: 34); Style: (FontSize: 22, TextColor: #ffff55, RenderBold: true, Alignment: Center, VerticalAlignment: Center); Text: ""; Visible: false; }
    Label #DamageTakenWater { Anchor: (Width: 120, Height: 34); Style: (FontSize: 22, TextColor: #5555ff, RenderBold: true, Alignment: Center, VerticalAlignment: Center); Text: ""; Visible: false; }
