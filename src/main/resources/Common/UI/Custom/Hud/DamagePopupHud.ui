    Label #DamageTakenShield { Anchor: (Width: 120, Height: 34); Style: (FontSize: 22, TextColor: #70e4ff, RenderBold: true, Alignment: Center, VerticalAlignment: Center); Text: ""; Visible: false; }
  }

  Group { Anchor: (Width: 210); }

