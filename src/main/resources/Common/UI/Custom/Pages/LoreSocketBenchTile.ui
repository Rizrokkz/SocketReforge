$Common = "../SocketReforge_Common.ui";
@LoreSlotHitStyle = TextButtonStyle(
  Default: (Background: #000000(0), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Hovered: (Background: #ffffff(0.08), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Pressed: (Background: #ffffff(0.12), LabelStyle: (FontSize: 1, TextColor: #ffffff(0)))
);

Group #LoreSocketTile {
  Anchor: (Width: 108, Height: 132);
  LayoutMode: Full;
  Group #LoreSocketVisual {
    Anchor: (Left: 14, Top: 16, Width: 80, Height: 80);
    LayoutMode: Center;
    Background: (TexturePath: "../GemSlotEmpty.png");
    Group #LoreSocketColorNone { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #2b2b3a(0.5); Visible: false; }
    Group #LoreSocketColorLocked { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #3a3a3a(0.5); Visible: false; }
    Group #LoreSocketColorRed { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #FF5555(0.5); Visible: false; }
    Group #LoreSocketColorBlue { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #5599FF(0.5); Visible: false; }
    Group #LoreSocketColorGreen { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #55FF77(0.5); Visible: false; }
    Group #LoreSocketColorPurple { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #AA55FF(0.5); Visible: false; }
    Group #LoreSocketColorYellow { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #FFFF55(0.5); Visible: false; }
    Group #LoreSocketColorOrange { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #FFAA00(0.5); Visible: false; }
    Group #LoreSocketColorBlack { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #555555(0.5); Visible: false; }
    Group #LoreSocketColorWhite { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #FFFFFF(0.5); Visible: false; }
    Group #LoreSocketColorCyan { Anchor: (Left: 3, Top: 3, Right: 3, Bottom: 3); Background: #55FFFF(0.5); Visible: false; }
    ItemIcon #LoreSocketIcon { ItemId: ""; Anchor: (Width: 56, Height: 56); Visible: false; }
  }
  Group #LoreSocketSelectionColorNone { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #e8c030; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #e8c030; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #e8c030; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #e8c030; }
    }
  Group #LoreSocketSelectionColorLocked { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #9ca3af; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #9ca3af; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #9ca3af; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #9ca3af; }
    }
  Group #LoreSocketSelectionColorRed { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #FF5555; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #FF5555; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #FF5555; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #FF5555; }
    }
  Group #LoreSocketSelectionColorBlue { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #5599FF; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #5599FF; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #5599FF; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #5599FF; }
    }
  Group #LoreSocketSelectionColorGreen { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #55FF77; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #55FF77; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #55FF77; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #55FF77; }
    }
  Group #LoreSocketSelectionColorPurple { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #AA55FF; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #AA55FF; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #AA55FF; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #AA55FF; }
    }
  Group #LoreSocketSelectionColorYellow { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #FFFF55; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #FFFF55; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #FFFF55; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #FFFF55; }
    }
  Group #LoreSocketSelectionColorOrange { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #FFAA00; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #FFAA00; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #FFAA00; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #FFAA00; }
    }
  Group #LoreSocketSelectionColorBlack { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #777777; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #777777; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #777777; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #777777; }
    }
  Group #LoreSocketSelectionColorWhite { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #FFFFFF; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #FFFFFF; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #FFFFFF; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #FFFFFF; }
    }
  Group #LoreSocketSelectionColorCyan { Anchor: (Full: 0); Visible: false;
      Group { Anchor: (Left: 12, Top: 14, Width: 84, Height: 2); Background: #55FFFF; }
      Group { Anchor: (Left: 12, Top: 96, Width: 84, Height: 2); Background: #55FFFF; }
      Group { Anchor: (Left: 12, Top: 14, Width: 2, Height: 84); Background: #55FFFF; }
      Group { Anchor: (Left: 94, Top: 14, Width: 2, Height: 84); Background: #55FFFF; }
    }
  TextButton #LoreSocketHit { Anchor: (Left: 8, Top: 12, Width: 92, Height: 92); Style: @LoreSlotHitStyle; Padding: (Full: 0); Text: ""; TooltipText: ""; }
  TextButton #LoreSocketFeed { Anchor: (Left: 6, Top: 108, Width: 96, Height: 22); Style: $Common.@SecondaryTextButtonStyle; Padding: (Horizontal: 2); Text: "FEED"; Visible: false; }
}
