$Common = "../SocketReforge_Common.ui";
Group #ToggleCard { Anchor: (Height: 74); LayoutMode: Left; Padding: (Left: 10, Right: 10, Top: 8, Bottom: 8); Background: #151e2a; Group { LayoutMode: Top; FlexWeight: 1; Label #ToggleTitle { Anchor: (Height: 24); Style: (FontSize: 12, TextColor: #e6ebf2, RenderBold: true, VerticalAlignment: Center); Text: "Setting"; } Label #ToggleDescription { FlexWeight: 1; Style: (FontSize: 10, TextColor: #9eacbb, VerticalAlignment: Center, Wrap: true); Text: ""; } } TextButton #ToggleValue { Anchor: (Width: 126, Height: 32); Text: "OFF"; Style: $Common.@SecondaryTextButtonStyle; } }
