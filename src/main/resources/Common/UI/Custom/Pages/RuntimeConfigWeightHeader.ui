Group #WeightHeader { Anchor: (Height: 34); LayoutMode: Left; Padding: (Left: 10, Right: 10, Top: 6, Bottom: 6); Background: #202b3a; Label { Anchor: (Width: 88); Text: "LEVEL"; Style: (FontSize: 9, TextColor: #aab7c5, RenderBold: true, VerticalAlignment: Center); } Label { FlexWeight: 1; Text: "DEGRADE"; Style: (FontSize: 9, TextColor: #aab7c5, HorizontalAlignment: Center, VerticalAlignment: Center); } Label { FlexWeight: 1; Text: "SAME"; Style: (FontSize: 9, TextColor: #aab7c5, HorizontalAlignment: Center, VerticalAlignment: Center); } Label { FlexWeight: 1; Text: "UPGRADE"; Style: (FontSize: 9, TextColor: #aab7c5, HorizontalAlignment: Center, VerticalAlignment: Center); } Label { FlexWeight: 1; Text: "JACKPOT"; Style: (FontSize: 9, TextColor: #e8c030, HorizontalAlignment: Center, VerticalAlignment: Center); } }
