$Common = "../SocketReforge_Common.ui";
Group #NumericTableRow { Anchor: (Height: 54); LayoutMode: Left; Padding: (Left: 10, Right: 10, Top: 4, Bottom: 4); Background: #151e2a; Group { FlexWeight: 1; LayoutMode: Top; Label #TableSetting { FlexWeight: 1; Style: (FontSize: 11, TextColor: #e6ebf2, RenderBold: true, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 8); Text: "Setting"; } Label #TableDescription { Anchor: (Height: 18); Style: (FontSize: 8, TextColor: #9eacbb, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 7); Text: "Description"; } } Group { Anchor: (Width: 240, Height: 36); LayoutMode: Left; NumberField #TableValue { FlexWeight: 1; Anchor: (Height: 32); Value: 0; Style: (FontSize: 11, TextColor: #e6ebf2); Background: #202c3b; Format: (MaxDecimalPlaces: 4, Step: 0.01); } Label #TableUnit { Anchor: (Width: 34); Style: (FontSize: 10, TextColor: #e8c030, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; } } }
