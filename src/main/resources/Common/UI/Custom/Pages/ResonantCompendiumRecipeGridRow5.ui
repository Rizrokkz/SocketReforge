Group #RecipeGridRow {
  Anchor: (Height: 242);
  LayoutMode: Left;
  Group #RecipeGridCell0 { FlexWeight: 1; LayoutMode: Top; Padding: (Full: 4); }
  Group { Anchor: (Width: 8); }
  Group #RecipeGridCell1 { FlexWeight: 1; LayoutMode: Top; Padding: (Full: 4); }
  Group { Anchor: (Width: 8); }
  Group #RecipeGridCell2 { FlexWeight: 1; LayoutMode: Top; Padding: (Full: 4); }
  Group { Anchor: (Width: 8); }
  Group #RecipeGridCell3 { FlexWeight: 1; LayoutMode: Top; Padding: (Full: 4); }
  Group { Anchor: (Width: 8); }
  Group #RecipeGridCell4 { FlexWeight: 1; LayoutMode: Top; Padding: (Full: 4); }
}
