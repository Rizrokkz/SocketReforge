@EssenceCardHitStyle = TextButtonStyle(
  Default: (Background: #000000(0), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Hovered: (Background: #ffffff(0.04), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Pressed: (Background: #ffffff(0.08), LabelStyle: (FontSize: 1, TextColor: #ffffff(0)))
);
@EssenceSocketHitStyle = TextButtonStyle(
  Default: (Background: #000000(0), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Hovered: (Background: #ffffff(0.08), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Pressed: (Background: #ffffff(0.12), LabelStyle: (FontSize: 1, TextColor: #ffffff(0)))
);
@EssenceLoreHitStyle = TextButtonStyle(
  Default: (Background: #000000(0), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Hovered: (Background: #ffffff(0.08), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Pressed: (Background: #ffffff(0.12), LabelStyle: (FontSize: 1, TextColor: #ffffff(0)))
);

Group #EquipmentCard {
  Anchor: (Height: 72);
  LayoutMode: Full;
  Background: #151c26;
  Group #EquipmentSelected { Anchor: (Left: 6, Top: 4, Bottom: 4, Width: 4); Background: #e8c030; Visible: false; }
  ItemIcon #EquipmentIcon { ItemId: "Weapon_Sword_Copper"; Anchor: (Left: 12, Top: 4, Width: 48, Height: 48); }
  Group #EquipmentInfo {
    Anchor: (Left: 76, Right: 10, Top: 4, Height: 36);
    LayoutMode: Top;
    Label #EquipmentName { Anchor: (Height: 34); Style: (FontSize: 12, TextColor: #eef1f5, RenderBold: true, VerticalAlignment: Center, Wrap: true, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9); Text: "Equipment"; }
  }
  ItemIcon #EquipmentResonantEssence { ItemId: "Ingredient_Resonant_Essence"; Anchor: (Left: 42, Top: 34, Width: 18, Height: 18); Visible: false; }
  Label #EquipmentSocketsCaption { Anchor: (Left: 76, Top: 48, Width: 44, Height: 16); Style: (FontSize: 8, TextColor: #8d98a8); Text: "Sockets"; }

  TextButton #EquipmentCardHit { Anchor: (Full: 0); Style: @EssenceCardHitStyle; Padding: (Full: 0); Text: ""; }

  Group #EquipmentSocketSlot0 { Anchor: (Left: 124, Top: 43, Width: 21, Height: 25); LayoutMode: Center; Group #EquipmentSocketVisual0 { Anchor: (Width: 20, Height: 20); LayoutMode: Center; Background: (TexturePath: "../slot_bg.png"); ItemIcon #EquipmentSocketEssence0 { ItemId: ""; Anchor: (Width: 16, Height: 16); Visible: false; } } TextButton #EquipmentSocketHit0 { Anchor: (Full: 0); Style: @EssenceSocketHitStyle; Padding: (Full: 0); Text: ""; } }
