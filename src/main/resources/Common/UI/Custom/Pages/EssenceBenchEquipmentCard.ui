  Group #EquipmentLoreSlot0 { Anchor: (Left: 241, Top: 43, Width: 21, Height: 25); LayoutMode: Center; Group #EquipmentLoreVisual0 { Anchor: (Width: 20, Height: 20); LayoutMode: Center; Background: (TexturePath: "../GemSlotEmpty.png");
