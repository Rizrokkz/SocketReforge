$Common = "../SocketReforge_Common.ui";
Group #ArrayEntry { Anchor: (Height: 66); LayoutMode: Top; Padding: (Left: 8, Right: 8, Top: 4, Bottom: 5); Background: #17202b; Label #ArrayKind { Anchor: (Height: 15); Text: "RULE"; Style: (FontSize: 8, TextColor: #82b9e8, RenderBold: true); } Group { LayoutMode: Left; FlexWeight: 1; TextField #ArrayValue { FlexWeight: 1; Anchor: (Height: 32); Value: ""; Style: (FontSize: 11, TextColor: #e6ebf2); Background: #202c3b; } Group { Anchor: (Width: 6); } TextButton #ArrayRemove { Anchor: (Width: 34, Height: 30); Text: "×"; Style: $Common.@DestructiveTextButtonStyle; } } }
