Group #TextCard { Anchor: (Height: 90); LayoutMode: Top; Padding: (Left: 10, Right: 10, Top: 7, Bottom: 7); Background: #151e2a; Label #TextTitle { Anchor: (Height: 23); Style: (FontSize: 12, TextColor: #e6ebf2, RenderBold: true, VerticalAlignment: Center); Text: "Setting"; } Label #TextDescription { Anchor: (Height: 24); Style: (FontSize: 10, TextColor: #9eacbb, VerticalAlignment: Center, Wrap: true); Text: ""; } TextField #TextValue { FlexWeight: 1; Anchor: (Height: 30); Value: ""; Style: (FontSize: 12, TextColor: #e6ebf2); Background: #202c3b; PlaceholderStyle: (TextColor: #69798a); } }
