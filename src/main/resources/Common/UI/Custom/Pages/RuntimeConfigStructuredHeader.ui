Group #StructuredHeader {
  Anchor: (Height: 26);
  LayoutMode: Left;
  // Match the row's 5px left inset and reserve 34px for the remove button plus 5px right inset.
  Padding: (Left: 5, Right: 39, Top: 3, Bottom: 3);
  Background: #202c3b;
  Group #StructuredHeaderField0 { FlexWeight: 2; Label #StructuredHeaderLabel0 { Anchor: (Full: 0); Style: (FontSize: 9, TextColor: #e8c030, RenderBold: true, VerticalAlignment: Center, ShrinkTextToFit: true); Text: ""; } }
  Group #StructuredHeaderField1 { FlexWeight: 1; Label #StructuredHeaderLabel1 { Anchor: (Full: 0); Style: (FontSize: 9, TextColor: #aab7c5, RenderBold: true, VerticalAlignment: Center, ShrinkTextToFit: true); Text: ""; } }
