@EssenceSupportHitStyle = TextButtonStyle(
  Default: (Background: #000000(0), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Hovered: (Background: #ffffff(0.04), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Pressed: (Background: #ffffff(0.08), LabelStyle: (FontSize: 1, TextColor: #ffffff(0)))
);

Group #SupportCard {
  Anchor: (Height: 58);
  LayoutMode: Full;
  Background: #151c26;
  Group #SupportSelected { Anchor: (Left: 6, Top: 5, Bottom: 5, Width: 4); Background: #e8c030; Visible: false; }
  ItemIcon #SupportIcon { ItemId: "Tool_Hammer_Iron"; Anchor: (Left: 12, Top: 7, Width: 44, Height: 44); }
  Group #SupportInfo { Anchor: (Left: 70, Right: 8, Top: 5, Height: 48); LayoutMode: Top;
    Label #SupportName { Anchor: (Height: 20); Style: (FontSize: 11, TextColor: #eef1f5, RenderBold: true, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 8); Text: "Support material"; }
    Label #SupportQuantity { Anchor: (Height: 18); Style: (FontSize: 9, TextColor: #c4ced8, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 7); Text: "Held: 0"; }
  }
  TextButton #SupportCardHit { Anchor: (Full: 0); Style: @EssenceSupportHitStyle; Padding: (Full: 0); Text: ""; TooltipText: ""; }
}
