Group #WeightRow { Anchor: (Height: 52); LayoutMode: Left; Padding: (Left: 10, Right: 10, Top: 7, Bottom: 7); Background: #151e2a; Label #WeightLevel { Anchor: (Width: 88); Style: (FontSize: 11, TextColor: #e8c030, RenderBold: true, VerticalAlignment: Center); Text: "Level 0"; } NumberField #WeightDegrade { FlexWeight: 1; Anchor: (Height: 32); Value: 0; Style: (FontSize: 11, TextColor: #e6ebf2); Background: #202c3b; Format: (MaxDecimalPlaces: 2, Step: 0.1); } NumberField #WeightSame { FlexWeight: 1; Anchor: (Height: 32); Value: 0; Style: (FontSize: 11, TextColor: #e6ebf2); Background: #202c3b; Format: (MaxDecimalPlaces: 2, Step: 0.1); } NumberField #WeightUpgrade { FlexWeight: 1; Anchor: (Height: 32); Value: 0; Style: (FontSize: 11, TextColor: #e6ebf2); Background: #202c3b; Format: (MaxDecimalPlaces: 2, Step: 0.1); } NumberField #WeightJackpot { FlexWeight: 1; Anchor: (Height: 32); Value: 0; Style: (FontSize: 11, TextColor: #e6ebf2); Background: #202c3b; Format: (MaxDecimalPlaces: 2, Step: 0.1); } }
