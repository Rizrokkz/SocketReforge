$Common = "../SocketReforge_Common.ui";
Group #NumericCard { Anchor: (Height: 112); LayoutMode: Top; Padding: (Left: 10, Right: 10, Top: 7, Bottom: 7); Background: #151e2a; Group { LayoutMode: Left; Anchor: (Height: 28); Label #NumericTitle { FlexWeight: 1; Style: (FontSize: 12, TextColor: #e6ebf2, RenderBold: true, VerticalAlignment: Center); Text: "Setting"; } Label #NumericUnit { Anchor: (Width: 70); Style: (FontSize: 10, TextColor: #e8c030, HorizontalAlignment: End, VerticalAlignment: Center); Text: ""; } } Label #NumericDescription { Anchor: (Height: 22); Style: (FontSize: 10, TextColor: #9eacbb, VerticalAlignment: Center, Wrap: true); Text: ""; } Group { LayoutMode: Left; FlexWeight: 1; NumberField #NumericValue { Anchor: (Width: 220, Height: 30); Value: 0; Style: (FontSize: 13, TextColor: #e6ebf2); Background: #202c3b; Format: (MaxDecimalPlaces: 4, Step: 0.01); } Group { FlexWeight: 1; } TextButton #RecalculateWeights { Anchor: (Width: 146, Height: 28); Text: "RECALCULATE"; Visible: false; Style: $Common.@SecondaryTextButtonStyle; } } }
