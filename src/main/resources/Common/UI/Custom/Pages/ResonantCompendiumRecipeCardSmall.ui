@RecipeCardHitStyle = TextButtonStyle(
  Default: (Background: #000000(0), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Hovered: (Background: #ffffff(0.035), LabelStyle: (FontSize: 1, TextColor: #ffffff(0))),
  Pressed: (Background: #ffffff(0.07), LabelStyle: (FontSize: 1, TextColor: #ffffff(0)))
);
@RecipeToolStyle = TextButtonStyle(
  Default: (Background: #26384c, LabelStyle: (FontSize: 10, TextColor: #d5dfeb, RenderBold: true)),
  Hovered: (Background: #35506d, LabelStyle: (FontSize: 10, TextColor: #ffffff, RenderBold: true)),
  Pressed: (Background: #42658b, LabelStyle: (FontSize: 10, TextColor: #ffffff, RenderBold: true))
);

Group #RecipeCard {
  Anchor: (Height: 118);
  LayoutMode: Full;
  Background: #151c26;
  Group #RecipeSelected { Anchor: (Left: 2, Top: 2, Bottom: 2, Width: 3); Background: #e8c030; Visible: false; }
  Label #RecipeName { Anchor: (Left: 3, Right: 44, Top: 2, Height: 21); Style: (FontSize: 9, TextColor: #eef1f5, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 7); Text: "Recipe"; }
  Label #RecipeMeta { Anchor: (Right: 23, Top: 1, Width: 20, Height: 13); Style: (FontSize: 8, TextColor: #e8c030, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 6); Text: "x0"; }
  Group #RecipeIconCenter { Anchor: (Left: 0, Right: 21, Top: 27, Bottom: 22); LayoutMode: Center;
    ItemIcon #RecipeIcon { ItemId: "Resonant_Recipe"; Anchor: (Width: 52, Height: 52); }
  }
  Group #RecipePatternIcons { Anchor: (Left: 1, Right: 22, Bottom: 1, Height: 19); LayoutMode: Center;
    Group #RecipePatternIconList { Anchor: (Width: 92, Height: 18); LayoutMode: Left; }
  }
  TextButton #RecipeSelect { Anchor: (Full: 0); Style: @RecipeCardHitStyle; Padding: (Full: 0); Text: ""; }
  Group #RecipeTools { Anchor: (Right: 1, Top: 0, Bottom: 0, Width: 18); LayoutMode: Full;
    TextButton #RecipeExtract { Anchor: (Right: 0, Top: 34, Width: 18, Height: 18); Style: @RecipeToolStyle; Padding: (Full: 0); Text: "E"; TooltipText: "Extract recipe"; Visible: false; }
    TextButton #RecipeCombine { Anchor: (Right: 0, Bottom: 8, Width: 18, Height: 18); Style: @RecipeToolStyle; Padding: (Full: 0); Text: "C"; TooltipText: "Combine recipe"; Visible: false; }
  }
}
